    "check:tokens": "node tools/audit-css.cjs",
    "check:render": "python3 tools/audit-render.py",
    "check:contrast": "python3 tools/audit-contrast.py",
    "check:engine": "node tools/test-themes.cjs",
    "check:player": "node tools/test-player-ui.cjs"
  },
