{
  "name": "tcs-radio",
  "version": "2.1.0",
  "description": "TCS Radio \u2014 2000s Indian Corporate Office, Auto Rickshaw & Highway Truck Retro Ambient Radio.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run check",
